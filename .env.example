NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI-compatible LLM (default DeepSeek). Leave empty to use recorded Agent demo.
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Agent daily quotas
AGENT_IP_DAILY_LIMIT=20
AGENT_GLOBAL_DAILY_LIMIT=200
# Optional override for quota file path (default /tmp/helong-agent-quota.json)
# AGENT_QUOTA_PATH=/tmp/helong-agent-quota.json
